VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN reader2_slot ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 46920 46240 ) ;
PINS 9 ;
    - prenh + NET prenh + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -140 ) ( 140 140 )
        + PLACED ( 20930 140 ) N ;
    - prenl + NET prenl + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -140 ) ( 140 140 )
        + PLACED ( 25070 140 ) N ;
    - x + NET x + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -140 ) ( 140 140 )
        + PLACED ( 27830 140 ) N ;
    - en + NET en + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -140 ) ( 140 140 )
        + PLACED ( 9430 46100 ) N ;
    - pre + NET pre + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -140 ) ( 140 140 )
        + PLACED ( 12190 46100 ) N ;
    - src[0] + NET src[0] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -140 ) ( 140 140 )
        + PLACED ( 14950 46100 ) N ;
    - src[1] + NET src[1] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -140 ) ( 140 140 )
        + PLACED ( 17710 46100 ) N ;
    - xa + NET xa + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -140 ) ( 140 140 )
        + PLACED ( 30590 46100 ) N ;
    - xb + NET xb + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -140 ) ( 140 140 )
        + PLACED ( 33350 46100 ) N ;
END PINS
END DESIGN
