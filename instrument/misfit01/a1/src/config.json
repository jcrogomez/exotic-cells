{
  "//": "MISFIT-01, arm A1: the hand-drawn inverter enters as a macro with its supply on metal 4. Everything below the marker is the Tiny Tapeout template, untouched.",
  "PL_TARGET_DENSITY_PCT": 60,
  "CLOCK_PERIOD": 20,
  "PL_RESIZER_HOLD_SLACK_MARGIN": 0.1,
  "GRT_RESIZER_HOLD_SLACK_MARGIN": 0.05,
  "RUN_LINTER": 1,
  "LINTER_INCLUDE_PDK_MODELS": 1,
  "CLOCK_PORT": "clk",

  "//": "Added for the hand-drawn macro: placement, views, and the declared supply connection (instance, supply net, ground net, supply pin, ground pin).",
  "MACROS": {
    "misfit_inv_m4": {
      "gds": ["dir::cells/misfit_inv_m4.gds"],
      "lef": ["dir::cells/misfit_inv_m4.lef"],
      "nl":  ["dir::cells/misfit_inv_m4_bb.v"],
      "spice": ["dir::cells/misfit_inv_m4.spice"],
      "instances": { "u_inv": {"location": [70.0, 50.0], "orientation": "N"} }
    }
  },
  "PDN_MACRO_CONNECTIONS": ["u_inv VPWR VGND VPWR VGND"],
  "EXTRA_SPICE_MODELS": ["dir::cells/misfit_inv_m4.spice"],

  "//": "Added so that LVS extracts the devices from the final GDS instead of trusting the abstract.",
  "MAGIC_EXT_USE_GDS": true,

  "//": "!!! DO NOT CHANGE ANYTHING BELOW THIS POINT !!!",
  "RUN_KLAYOUT_XOR": 0,
  "RUN_KLAYOUT_DRC": 0,
  "DESIGN_REPAIR_BUFFER_OUTPUT_PORTS": 0,
  "TOP_MARGIN_MULT": 1,
  "BOTTOM_MARGIN_MULT": 1,
  "LEFT_MARGIN_MULT": 6,
  "RIGHT_MARGIN_MULT": 6,
  "FP_SIZING": "absolute",
  "GRT_ALLOW_CONGESTION": 1,
  "FP_IO_HLENGTH": 2,
  "FP_IO_VLENGTH": 2,
  "FP_PDN_VPITCH": 38.87,
  "RUN_CTS": 1,
  "FP_PDN_MULTILAYER": 0,
  "MAGIC_DEF_LABELS": 0,
  "MAGIC_WRITE_LEF_PINONLY": 1
}
